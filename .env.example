# Nexus Team Hub Environment Variables

# Web Frontend (Public)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# API Backend (Private)
PORT=3001
NODE_ENV=development
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres
